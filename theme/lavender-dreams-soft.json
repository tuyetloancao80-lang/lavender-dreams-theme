{
    "$schema": "vscode://schemas/color-theme",
    "name": "Lavender Dreams Soft",
    "author": "Lavender Studio",
    "semanticClass": "theme.lavender-dreams-soft",
    "semanticHighlighting": true,
    "colors": {
        // ТЕРМИНАЛ (16 ANSI цветов + фон/передний план)
        "terminal.background": "#2d273b",
        "terminal.foreground": "#e8e4f0",
        "terminal.ansiBlack": "#221d2a",
        "terminal.ansiRed": "#c99ac9",
        "terminal.ansiGreen": "#a08bc4",
        "terminal.ansiYellow": "#d4cbf0",
        "terminal.ansiBlue": "#b89cc8",
        "terminal.ansiMagenta": "#c7a7d2",
        "terminal.ansiCyan": "#a89eb8",
        "terminal.ansiWhite": "#e8e4f0",
        "terminal.ansiBrightBlack": "#2a2436",
        "terminal.ansiBrightRed": "#d4a4d4",
        "terminal.ansiBrightGreen": "#b39cd4",
        "terminal.ansiBrightYellow": "#e0d8f0",
        "terminal.ansiBrightBlue": "#c3abd8",
        "terminal.ansiBrightMagenta": "#d2b7dc",
        "terminal.ansiBrightCyan": "#b8aec8",
        "terminal.ansiBrightWhite": "#f0ecf8",

        // ОСНОВНЫЕ ЭЛЕМЕНТЫ ИНТЕРФЕЙСА
        "focusBorder": "#a08bc4",
        "foreground": "#e8e4f0",
        "selection.background": "#a08bc440",
        "errorForeground": "#c99ac9",

        // КНОПКИ И ЭЛЕМЕНТЫ УПРАВЛЕНИЯ
        "button.background": "#a08bc4",
        "button.foreground": "#221d2a",
        "button.hoverBackground": "#b89cc8",
        "button.secondaryBackground": "#2a2436",
        "button.secondaryForeground": "#d0c8e0",
        "button.secondaryHoverBackground": "#2d273b",
        "dropdown.background": "#2a2436",
        "dropdown.border": "#a08bc4",
        "dropdown.foreground": "#e8e4f0",

        // ПОЛЯ ВВОДА
        "input.background": "#2a2436",
        "input.foreground": "#e8e4f0",
        "input.border": "#a08bc4",
        "input.placeholderForeground": "#a89eb8",
        "inputOption.activeBorder": "#b89cc8",
        "inputValidation.infoBorder": "#b89cc8",
        "inputValidation.warningBorder": "#d4cbf0",
        "inputValidation.errorBorder": "#c99ac9",

        // ЗНАЧКИ И ПРОГРЕСС
        "badge.foreground": "#221d2a",
        "badge.background": "#a08bc4",
        "progressBar.background": "#b89cc8",

        // СПИСКИ
        "list.activeSelectionBackground": "#a08bc425",
        "list.activeSelectionForeground": "#e8e4f0",
        "list.dropBackground": "#a08bc415",
        "list.focusBackground": "#a08bc415",
        "list.highlightForeground": "#b89cc8",
        "list.hoverBackground": "#c7a7d215",
        "list.inactiveSelectionBackground": "#a08bc415",
        "list.warningForeground": "#d4cbf0",
        "list.errorForeground": "#c99ac9",

        // ПАНЕЛЬ АКТИВНОСТИ
        "activityBar.background": "#221d2a",
        "activityBar.inactiveForeground": "#a89eb8",
        "activityBar.foreground": "#e8e4f0",
        "activityBar.activeBorder": "#a08bc4",
        "activityBar.activeBackground": "#a08bc415",
        "activityBarBadge.background": "#b89cc8",
        "activityBarBadge.foreground": "#221d2a",

        // БОКОВАЯ ПАНЕЛЬ
        "sideBar.background": "#2a2436",
        "sideBarTitle.foreground": "#e8e4f0",
        "sideBarSectionHeader.background": "#221d2a",
        "sideBarSectionHeader.border": "#a08bc425",

        // ГРУППЫ РЕДАКТОРОВ И ВКЛАДКИ
        "editorGroup.border": "#a08bc425",
        "editorGroup.dropBackground": "#a08bc415",
        "editorGroupHeader.tabsBackground": "#221d2a",
        "tab.activeBackground": "#2d273b",
        "tab.activeForeground": "#e8e4f0",
        "tab.border": "#221d2a",
        "tab.activeBorderTop": "#a08bc4",
        "tab.inactiveBackground": "#221d2a",
        "tab.inactiveForeground": "#a89eb8",

        // РЕДАКТОР
        "editor.foreground": "#e8e4f0",
        "editor.background": "#2d273b",
        "editorLineNumber.foreground": "#a89eb8",
        "editorLineNumber.activeForeground": "#d0c8e0",
        "editor.selectionBackground": "#a08bc435",
        "editor.selectionHighlightBackground": "#a08bc425",
        "editor.foldBackground": "#c7a7d215",
        "editor.wordHighlightBackground": "#b89cc825",
        "editor.wordHighlightStrongBackground": "#b89cc835",
        "editor.findMatchBackground": "#c99ac950",
        "editor.findMatchHighlightBackground": "#c99ac925",
        "editor.findRangeHighlightBackground": "#a08bc415",
        "editor.hoverHighlightBackground": "#c7a7d215",
        "editor.lineHighlightBorder": "#a08bc415",
        "editorLink.activeForeground": "#b89cc8",
        "editor.rangeHighlightBackground": "#a08bc415",

        // ПОДСВЕТКА СКОБОК
        "editorBracketHighlight.foreground1": "#a08bc4",
        "editorBracketHighlight.foreground2": "#b89cc8",
        "editorBracketHighlight.foreground3": "#c7a7d2",
        "editorBracketHighlight.foreground4": "#c99ac9",
        "editorBracketHighlight.foreground5": "#d4cbf0",
        "editorBracketHighlight.foreground6": "#e8e4f0",
        "editorBracketHighlight.unexpectedBracket.foreground": "#c99ac9",

        // ОБЗОРНАЯ ЛИНЕЙКА
        "editorOverviewRuler.border": "#221d2a",
        "editorOverviewRuler.selectionHighlightForeground": "#a08bc470",
        "editorOverviewRuler.wordHighlightForeground": "#b89cc870",
        "editorOverviewRuler.wordHighlightStrongForeground": "#c7a7d270",
        "editorOverviewRuler.modifiedForeground": "#b89cc8",
        "editorOverviewRuler.addedForeground": "#a08bc4",
        "editorOverviewRuler.deletedForeground": "#c99ac9",
        "editorOverviewRuler.errorForeground": "#c99ac9",
        "editorOverviewRuler.warningForeground": "#d4cbf0",
        "editorOverviewRuler.infoForeground": "#b89cc8",

        // ОШИБКИ И ПРЕДУПРЕЖДЕНИЯ
        "editorError.foreground": "#c99ac9",
        "editorWarning.foreground": "#d4cbf0",
        "editorInfo.foreground": "#b89cc8",
        "editorGutter.modifiedBackground": "#b89cc8",
        "editorGutter.addedBackground": "#a08bc4",
        "editorGutter.deletedBackground": "#c99ac9",

        // GIT ДЕКОРАЦИИ
        "gitDecoration.modifiedResourceForeground": "#b89cc8",
        "gitDecoration.deletedResourceForeground": "#c99ac9",
        "gitDecoration.untrackedResourceForeground": "#a08bc4",
        "gitDecoration.ignoredResourceForeground": "#a89eb8",
        "gitDecoration.conflictingResourceForeground": "#d4cbf0",

        // DIFF РЕДАКТОР
        "diffEditor.insertedTextBackground": "#a08bc415",
        "diffEditor.removedTextBackground": "#c99ac915",

        // ВИДЖЕТЫ РЕДАКТОРА
        "editorWidget.background": "#221d2a",
        "editorWidget.border": "#a08bc4",
        "editorSuggestWidget.background": "#221d2a",
        "editorSuggestWidget.foreground": "#e8e4f0",
        "editorSuggestWidget.selectedBackground": "#a08bc425",
        "editorHoverWidget.background": "#221d2a",
        "editorHoverWidget.border": "#a08bc4",

        // ПАНЕЛИ
        "panel.background": "#2a2436",
        "panel.border": "#a08bc425",
        "panelTitle.activeBorder": "#a08bc4",
        "panelTitle.activeForeground": "#e8e4f0",
        "panelTitle.inactiveForeground": "#a89eb8",

        // СТАТУС БАР
        "statusBar.background": "#221d2a",
        "statusBar.foreground": "#e8e4f0",
        "statusBar.debuggingBackground": "#b89cc8",
        "statusBar.debuggingForeground": "#221d2a",
        "statusBar.noFolderBackground": "#2a2436",
        "statusBar.noFolderForeground": "#d0c8e0",
        "statusBarItem.prominentBackground": "#a08bc4",
        "statusBarItem.prominentHoverBackground": "#b89cc8",
        "statusBarItem.remoteForeground": "#221d2a",
        "statusBarItem.remoteBackground": "#c7a7d2",

        // ЗАГОЛОВОК ОКНА
        "titleBar.activeBackground": "#221d2a",
        "titleBar.activeForeground": "#e8e4f0",
        "titleBar.inactiveBackground": "#221d2a",
        "titleBar.inactiveForeground": "#a89eb8",

        // НАСТРОЙКИ
        "settings.headerForeground": "#e8e4f0",
        "settings.modifiedItemIndicator": "#b89cc8",
        "settings.dropdownBackground": "#2a2436",
        "settings.dropdownForeground": "#e8e4f0",
        "settings.dropdownBorder": "#a08bc4",
        "settings.checkboxBackground": "#2a2436",
        "settings.checkboxForeground": "#e8e4f0",
        "settings.checkboxBorder": "#a08bc4",
        "settings.textInputBackground": "#2a2436",
        "settings.textInputForeground": "#e8e4f0",
        "settings.textInputBorder": "#a08bc4",
        "settings.numberInputBackground": "#2a2436",
        "settings.numberInputForeground": "#e8e4f0",
        "settings.numberInputBorder": "#a08bc4",

        // ХЛЕБНЫЕ КРОШКИ
        "breadcrumb.foreground": "#a89eb8",
        "breadcrumb.background": "#2d273b",
        "breadcrumb.focusForeground": "#e8e4f0",
        "breadcrumb.activeSelectionForeground": "#b89cc8",
        "breadcrumbPicker.background": "#221d2a"
    },
    "tokenColors": [
        // БАЗОВОЕ ФОРМАТИРОВАНИЕ
        {
            "scope": ["emphasis"],
            "settings": {"fontStyle": "italic"}
        },
        {
            "scope": ["strong"],
            "settings": {"fontStyle": "bold"}
        },
        {
            "scope": ["header"],
            "settings": {"foreground": "#b89cc8"}
        },

        // КОММЕНТАРИИ
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {"foreground": "#a89eb8", "fontStyle": "italic"}
        },
        {
            "name": "JSDoc keywords",
            "scope": ["comment keyword.codetag.notation", "comment.block.documentation keyword"],
            "settings": {"foreground": "#c7a7d2"}
        },

        // СТРОКИ
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": {"foreground": "#d4cbf0"}
        },
        {
            "name": "String quotes",
            "scope": ["punctuation.definition.string.begin", "punctuation.definition.string.end"],
            "settings": {"foreground": "#c7a7d2"}
        },

        // ЧИСЛА И КОНСТАНТЫ
        {
            "name": "Constants",
            "scope": ["constant", "variable.other.constant"],
            "settings": {"foreground": "#c99ac9"}
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": {"foreground": "#b89cc8"}
        },

        // КЛЮЧЕВЫЕ СЛОВА
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": {"foreground": "#a08bc4", "fontStyle": "bold"}
        },

        // ФУНКЦИИ
        {
            "name": "Function names",
            "scope": ["entity.name.function", "meta.function-call"],
            "settings": {"foreground": "#b89cc8"}
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter"],
            "settings": {"foreground": "#d0c8e0", "fontStyle": "italic"}
        },

        // КЛАССЫ И ТИПЫ
        {
            "name": "Classes",
            "scope": ["entity.name.type.class", "entity.name.class"],
            "settings": {"foreground": "#c7a7d2"}
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "storage.type"],
            "settings": {"foreground": "#b89cc8", "fontStyle": "italic"}
        },

        // ПЕРЕМЕННЫЕ
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": {"foreground": "#e8e4f0"}
        },
        {
            "name": "Language variables",
            "scope": ["variable.language"],
            "settings": {"foreground": "#c99ac9", "fontStyle": "italic"}
        },

        // HTML/XML
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag"],
            "settings": {"foreground": "#a08bc4"}
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": {"foreground": "#b89cc8", "fontStyle": "italic"}
        },

        // CSS
        {
            "name": "CSS selectors",
            "scope": ["meta.selector"],
            "settings": {"foreground": "#c7a7d2"}
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name"],
            "settings": {"foreground": "#b89cc8"}
        },

        // ОПЕРАТОРЫ И ПУНКТУАЦИЯ
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": {"foreground": "#a08bc4"}
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": {"foreground": "#d0c8e0"}
        },

        // РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
        {
            "name": "RegExp",
            "scope": ["string.regexp"],
            "settings": {"foreground": "#d4cbf0"}
        },

        // MARKDOWN
        {
            "name": "Markdown headings",
            "scope": ["markup.heading"],
            "settings": {"foreground": "#b89cc8", "fontStyle": "bold"}
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": {"foreground": "#c7a7d2", "fontStyle": "bold"}
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": {"foreground": "#d4cbf0", "fontStyle": "italic"}
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link"],
            "settings": {"foreground": "#a08bc4"}
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw"],
            "settings": {"foreground": "#c99ac9"}
        },

        // НЕДЕЙСТВИТЕЛЬНЫЙ КОД
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": {"foreground": "#c99ac9", "fontStyle": "underline"}
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {"foreground": "#a89eb8", "fontStyle": "strikethrough"}
        }
    ]
}
